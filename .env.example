# Google Sheets Configuration
GOOGLE_SHEETS_ID=your-google-sheets-id-here
GOOGLE_APPLICATION_CREDENTIALS=.././credentials/service-account.json

# Firebase Configuration (Server)
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase Configuration (Client - Vite prefix required)
VITE_API_URL=http://localhost:3001
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id

# Cloud Run Configuration (Production)
CLOUD_RUN_SERVICE_ACCOUNT=scheduler-sa@your-project.iam.gserviceaccount.com
